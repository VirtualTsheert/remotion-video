{
  "name": "studio",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/d3-geo": "3.1.0",
    "@types/react": "19.2.7",
    "@types/three": "0.178.0",
    "@types/web": "0.0.166",
    "d3-geo": "3.1.1",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render",
    "render:draft": "remotion render --scale=0.5 --crf=28 --props='{\"quality3d\":0.5}'",
    "still": "remotion still",
    "qc": "node scripts/qc.mjs",
    "preview": "node scripts/preview-frames.mjs",
    "plates": "node scripts/plates.mjs",
    "imagery": "node scripts/fetch-imagery.mjs",
    "audio:lebah": "node scripts/synth-lebah-audio.mts",
    "render:lebah": "node scripts/synth-lebah-audio.mts && remotion render Lebah out/Lebah-silent.mp4 && ffmpeg -y -loglevel error -i out/Lebah-silent.mp4 -i public/audio/lebah/soundtrack.wav -map 0:v -map 1:a -c:v copy -c:a aac -b:a 192k -shortest out/Lebah.mp4",
    "audio:kucing": "node scripts/synth-kucing-audio.mts",
    "render:kucing": "REMOTION_WITH_AUDIO=1 remotion render Kucing out/Kucing.mp4",
    "render:kucing:draft": "REMOTION_WITH_AUDIO=1 remotion render Kucing out/Kucing-draft.mp4 --scale=0.5 --crf=28"
  },
  "allowScripts": {
    "esbuild": false
  }
}
